# Copy to .env (gitignored) and fill in. Never commit real values.
# Only needed from Milestone 5 (approval service / Vast.ai launcher).
# Email when the trailer is ready (or a run fails). Gmail: enable 2-Step Verification,
# then create an app password at https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
VAST_API_KEY=
STORAGE_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
HF_TOKEN=
